{
  "rules": {
    "fitstake": {
      "users": { ".read": true, "$uid": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.hasChildren(['name'])", "name": { ".validate": "newData.isString() && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "$other": { ".validate": false } } },
      "challenge_main": { "participants": { ".read": true, "$uid": { ".write": "auth != null && auth.uid === $uid", "name": { ".validate": "newData.isString() && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "total": { ".validate": "newData.isNumber() && newData.val() >= 0" }, "days": { "$date": { "$exercise": { ".validate": "newData.isNumber() && newData.val() >= 0" } } }, "restartFrom": { ".validate": "newData.isString() && newData.val().length === 10" }, "$other": { ".validate": false } } } },
      "challenges": {
        ".read": true,
        "$challengeId": {
          "meta": { ".write": "auth != null && !data.exists() && newData.child('ownerId').val() === auth.uid", ".validate": "newData.hasChildren(['ownerId','title','goals','durationDays','buyIn','missPolicy','createdAt'])", "ownerId": { ".validate": "newData.isString() && newData.val() === auth.uid" }, "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }, "goals": { ".validate": "newData.hasChildren()" }, "durationDays": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365" }, "buyIn": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }, "missPolicy": { ".validate": "newData.val() === 'never' || newData.val() === 'oneTotal' || newData.val() === 'onePerTwoWeeks'" }, "progressionStep": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }, "progressionPeriod": { ".validate": "newData.val() === 'day' || newData.val() === 'week'" }, "createdAt": { ".validate": "newData.isNumber()" }, "startAt": { ".validate": "newData.isNumber()" }, "type": { ".validate": "newData.val() === 'streak' || newData.val() === 'goal'" }, "access": { ".validate": "newData.val() === 'solo' || newData.val() === 'private' || newData.val() === 'public'" }, "minPlayers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }, "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" }, "$other": { ".validate": false } },
          "participants": { "$uid": { ".write": "auth != null && auth.uid === $uid", "name": { ".validate": "newData.isString() && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "total": { ".validate": "newData.isNumber() && newData.val() >= 0" }, "ready": { ".validate": "newData.isNumber()" }, "days": { "$date": { "$exercise": { ".validate": "newData.isNumber() && newData.val() >= 0" } } }, "restartFrom": { ".validate": "newData.isString() && newData.val().length === 10" }, "$other": { ".validate": false } } },
          "startAt": { ".write": "auth != null && data.parent().child('meta/ownerId').val() === auth.uid", ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "follows": {
        ".read": true,
        "$followerUid": {
          "$targetUid": {
            ".write": "auth != null && auth.uid === $followerUid",
            ".validate": "newData.val() === true"
          }
        }
      },
      "activity": {
        ".read": "auth != null",
        "$eventId": {
          ".write": "auth != null && !data.exists() && newData.child('actorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['actorId','actorName','challengeId','challengeTitle','type','ts'])",
          "actorId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "actorName": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "challengeId": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "challengeTitle": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "type": { ".validate": "newData.val() === 'exercise' || newData.val() === 'day' || newData.val() === 'start'" },
          "exercise": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "dateKey": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "reactions": {
        ".read": "auth != null",
        "$eventId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.val() === '🔥' || newData.val() === '💪' || newData.val() === '👏'"
          }
        }
      },
      "bugReports": { ".read": false, "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.hasChildren(['category', 'ts'])", "category": { ".validate": "newData.isString() && newData.val().length <= 40" }, "problem": { ".validate": "newData.isString() && newData.val().length <= 80" }, "note": { ".validate": "newData.isString() && newData.val().length <= 1000" }, "screen": { ".validate": "newData.isString() && newData.val().length <= 40" }, "version": { ".validate": "newData.isString() && newData.val().length <= 16" }, "device": { ".validate": "newData.isString() && newData.val().length <= 300" }, "lang": { ".validate": "newData.isString() && newData.val().length <= 4" }, "err": { ".validate": "newData.isString() && newData.val().length <= 500" }, "uid": { ".validate": "newData.isString() && newData.val().length <= 40" }, "ts": { ".validate": "newData.isNumber()" }, "$other": { ".validate": false } } }
    }
  }
}
