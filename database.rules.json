{
  "rules": {
    "fitstake": {
      "users": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "joinedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "challenge_main": {
        "participants": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "days": {
              "$date": {
                "$exercise": { ".validate": "newData.isNumber() && newData.val() >= 0" }
              }
            }
          }
        }
      },
      "bugReports": {
        ".read": true,
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['category', 'ts'])",
          "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "problem": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "screen": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "version": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "device": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "lang": { ".validate": "newData.isString() && newData.val().length <= 4" },
          "err": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "uid": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
