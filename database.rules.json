{
  "rules": {
    "fitstake": {
      "users": { ".read": true, "$uid": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.hasChildren(['name'])", "name": { ".validate": "newData.isString() && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "$other": { ".validate": false } } },
      "challenge_main": { "participants": { ".read": true, "$uid": { ".write": "auth != null && auth.uid === $uid", "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" }, "days": { "$date": { ".validate": "$date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)", "$exercise": { ".validate": "($exercise === 'pushups' || $exercise === 'squats' || $exercise === 'pullups' || $exercise === 'dips') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000 && newData.val() % 1 === 0" } } }, "restartFrom": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" }, "$other": { ".validate": false } } } },
      "publicChallenges": {
        ".read": true,
        "$challengeId": {
          ".validate": "$challengeId.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.child('meta/access').val() === 'public'",
          "meta": { ".write": "auth != null && !data.exists() && newData.child('ownerId').val() === auth.uid", ".validate": "newData.hasChildren(['ownerId','title','goals','durationDays','buyIn','missPolicy','createdAt'])", "ownerId": { ".validate": "newData.isString() && newData.val() === auth.uid" }, "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }, "goals": { ".validate": "newData.hasChildren()" }, "durationDays": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365" }, "buyIn": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }, "missPolicy": { ".validate": "newData.val() === 'never' || newData.val() === 'oneTotal' || newData.val() === 'onePerTwoWeeks'" }, "progressionStep": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }, "progressionPeriod": { ".validate": "newData.val() === 'day' || newData.val() === 'week'" }, "focusApps": { ".validate": "newData.hasChildren()", "$index": { ".validate": "$index.matches(/^[0-4]$/) && newData.isString() && (newData.val() === 'instagram' || newData.val() === 'tiktok' || newData.val() === 'youtube' || newData.val() === 'games' || newData.val() === 'social')" } }, "scheduledWeekdays": { ".validate": "newData.hasChildren()", "$index": { ".validate": "$index.matches(/^[0-6]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 7 && newData.val() % 1 === 0" } }, "resetMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439 && newData.val() % 1 === 0" }, "focusLockEnabled": { ".validate": "newData.isBoolean()" }, "timeZoneIdentifier": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" }, "createdAt": { ".validate": "newData.isNumber()" }, "startAt": { ".validate": "newData.isNumber()" }, "type": { ".validate": "newData.val() === 'streak' || newData.val() === 'goal'" }, "access": { ".validate": "newData.val() === 'solo' || newData.val() === 'private' || newData.val() === 'public'" }, "minPlayers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }, "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" }, "$other": { ".validate": false } },
          "participants": { "$uid": { ".write": "auth != null && auth.uid === $uid", "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" }, "ready": { ".validate": "newData.isNumber()" }, "days": { "$date": { ".validate": "$date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)", "$exercise": { ".validate": "($exercise === 'pushups' || $exercise === 'squats' || $exercise === 'pullups' || $exercise === 'dips') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000 && newData.val() % 1 === 0" } } }, "restartFrom": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" }, "$other": { ".validate": false } } },
          "startAt": { ".write": "auth != null && data.parent().child('meta/ownerId').val() === auth.uid", ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "privateChallenges": {
        "$challengeId": {
          ".read": "auth != null && (data.child('meta/ownerId').val() === auth.uid || data.child('participants').child(auth.uid).exists())",
          ".validate": "$challengeId.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.child('meta/access').val() === 'private'",
          "meta": { ".read": "auth != null", ".write": "auth != null && !data.exists() && newData.child('ownerId').val() === auth.uid", ".validate": "newData.hasChildren(['ownerId','title','goals','durationDays','buyIn','missPolicy','createdAt'])", "ownerId": { ".validate": "newData.isString() && newData.val() === auth.uid" }, "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }, "goals": { ".validate": "newData.hasChildren()" }, "durationDays": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365" }, "buyIn": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }, "missPolicy": { ".validate": "newData.val() === 'never' || newData.val() === 'oneTotal' || newData.val() === 'onePerTwoWeeks'" }, "progressionStep": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }, "progressionPeriod": { ".validate": "newData.val() === 'day' || newData.val() === 'week'" }, "focusApps": { ".validate": "newData.hasChildren()", "$index": { ".validate": "$index.matches(/^[0-4]$/) && newData.isString() && (newData.val() === 'instagram' || newData.val() === 'tiktok' || newData.val() === 'youtube' || newData.val() === 'games' || newData.val() === 'social')" } }, "scheduledWeekdays": { ".validate": "newData.hasChildren()", "$index": { ".validate": "$index.matches(/^[0-6]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 7 && newData.val() % 1 === 0" } }, "resetMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439 && newData.val() % 1 === 0" }, "focusLockEnabled": { ".validate": "newData.isBoolean()" }, "timeZoneIdentifier": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" }, "createdAt": { ".validate": "newData.isNumber()" }, "startAt": { ".validate": "newData.isNumber()" }, "type": { ".validate": "newData.val() === 'streak' || newData.val() === 'goal'" }, "access": { ".validate": "newData.val() === 'private'" }, "minPlayers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }, "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" }, "$other": { ".validate": false } },
          "participants": { "$uid": { ".write": "auth != null && auth.uid === $uid", "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" }, "joinedAt": { ".validate": "newData.isNumber()" }, "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" }, "ready": { ".validate": "newData.isNumber()" }, "days": { "$date": { ".validate": "$date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)", "$exercise": { ".validate": "($exercise === 'pushups' || $exercise === 'squats' || $exercise === 'pullups' || $exercise === 'dips') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000 && newData.val() % 1 === 0" } } }, "restartFrom": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" }, "$other": { ".validate": false } } },
          "startAt": { ".write": "auth != null && data.parent().child('meta/ownerId').val() === auth.uid", ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "follows": {
        ".read": true,
        "$followerUid": {
          "$targetUid": {
            ".write": "auth != null && auth.uid === $followerUid",
            ".validate": "newData.val() === true"
          }
        }
      },
      "activity": {
        ".read": "auth != null",
        "$eventId": {
          ".write": "auth != null && !data.exists() && newData.child('actorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['actorId','actorName','challengeId','challengeTitle','type','ts'])",
          "actorId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "actorName": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "challengeId": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "challengeTitle": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "type": { ".validate": "newData.val() === 'exercise' || newData.val() === 'day' || newData.val() === 'start'" },
          "exercise": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "dateKey": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "reactions": {
        ".read": "auth != null",
        "$eventId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.val() === '🔥' || newData.val() === '💪' || newData.val() === '👏'"
          }
        }
      },
      "deletionRequests": { "$uid": { ".read": false, ".write": "auth != null && auth.uid === $uid", ".validate": "newData.hasChildren(['requestedAt'])", "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now" }, "$other": { ".validate": false } } },
      "bugReports": { ".read": false, "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.hasChildren(['category', 'note', 'ts'])", "category": { ".validate": "newData.isString() && newData.val().length <= 40" }, "severity": { ".validate": "newData.val() === 'low' || newData.val() === 'normal' || newData.val() === 'high' || newData.val() === 'critical'" }, "note": { ".validate": "newData.isString() && newData.val().length <= 1000" }, "screen": { ".validate": "newData.isString() && newData.val().length <= 40" }, "viewport": { ".validate": "newData.isString() && newData.val().length <= 16" }, "version": { ".validate": "newData.isString() && newData.val().length <= 16" }, "device": { ".validate": "newData.isString() && newData.val().length <= 300" }, "lang": { ".validate": "newData.isString() && newData.val().length <= 4" }, "err": { ".validate": "newData.isString() && newData.val().length <= 500" }, "hasShot": { ".validate": "newData.isBoolean()" }, "uid": { ".validate": "newData.isString() && newData.val().length <= 40" }, "ts": { ".validate": "newData.isNumber()" }, "$other": { ".validate": false } } },
      "bugShots": { ".read": false, "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.isString() && newData.val().length <= 400000" } }
    }
  }
}
